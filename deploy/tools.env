# Versions used by the Linux image build. Override through build args when a
# release has been validated against a different pinned tool set.
AXIOM_FFUF_VERSION=v2.1.0
AXIOM_KATANA_VERSION=v1.6.1
AXIOM_HTTPX_VERSION=v1.9.0
AXIOM_SUBFINDER_VERSION=v2.14.0
AXIOM_NUCLEI_VERSION=v3.8.0

# Database rollback is conservative by default. Set to 1 only after verifying
# that the target release's migrations are backward-compatible with the prior
# application image.
AXIOM_DATABASE_MIGRATION_TARGET=postgresql@head
AXIOM_DATABASE_ROLLBACK_COMPATIBLE=0
