# AXIOM deployment settings. The installer generates secrets when this file
# does not already exist. Passwords intentionally remain plain environment
# values to preserve AXIOM's existing configuration behavior.
AXIOM_VERSION=0.1.0
AXIOM_COMPOSE_PROJECT=axiom
AXIOM_IMAGE=ghcr.io/notstarr/axiom:0.1.0
AXIOM_POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382

AXIOM_PUBLISH_HOST=127.0.0.1
AXIOM_PORT=8888
AXIOM_DATA_DIR=/var/lib/axiom

AXIOM_DB_HOST=postgres
AXIOM_DB_PORT=5432
AXIOM_DB_NAME=axiom
AXIOM_DB_MIGRATOR_PASSWORD=change-me-migrator
AXIOM_DB_APP_PASSWORD=change-me-app
AXIOM_POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap
AXIOM_SERVICE_TOKEN=change-me-service-token
AXIOM_INTERNAL_SERVER_URL=http://api:8899

CHROME_HEADLESS=1
CHROME_BIN=/usr/bin/chromium
CHROME_NO_SANDBOX=1
AXIOM_CHROME_PROFILE_DIR=/var/lib/axiom-browser-profile

AXIOM_POSTGRES_VOLUME=axiom-postgres
AXIOM_DATA_VOLUME=axiom-data
AXIOM_BROWSER_VOLUME=axiom-browser-profile
AXIOM_NETWORK=axiom
