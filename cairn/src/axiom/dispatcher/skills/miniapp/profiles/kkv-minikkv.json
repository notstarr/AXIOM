{
  "id": "kkv-minikkv",
  "name": "KKV / MiniKKV 微信小程序",
  "hosts": ["api-gateway.kkguan.com"],
  "entry_path": "/client/app",
  "client": "MiniKKV",
  "project": "MiniKKV",
  "os": "WeChat",
  "auth": {
    "headers": ["Cookie", "X-TOKEN"],
    "cookie_names": ["KKGUANSESSIONIDNEW"],
    "body_token_path": "data.params.token"
  },
  "api_code_patterns": [
    "UserCenter/",
    "Order/",
    "Pay/",
    "Coupon/",
    "PointMall/",
    "Cart/",
    "Address/",
    "Goods/"
  ],
  "readonly_probe_codes": [
    "UserCenter/User/index"
  ],
  "dangerous_keywords": [
    "requestPayment",
    "Pay/",
    "Order/create",
    "Coupon/receive",
    "PointMall/exchange",
    "Address/delete"
  ]
}
