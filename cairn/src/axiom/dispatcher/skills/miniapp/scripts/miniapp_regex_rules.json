{
  "version": 1,
  "description": "AXIOM miniapp static extraction rules inspired by common miniapp decompile scanners.",
  "rules": [
    {
      "id": "url_http",
      "category": "url",
      "severity": "info",
      "description": "HTTP/HTTPS URL",
      "regex": "(https?://[^\\s'\\\"`<>\\\\)\\]}]+)"
    },
    {
      "id": "host_domain",
      "category": "host",
      "severity": "info",
      "description": "Domain or host candidate",
      "regex": "(?<![\\w.-])((?:[a-z0-9-]+\\.)+[a-z]{2,}(?::\\d{2,5})?)(?![\\w.-])"
    },
    {
      "id": "miniapp_page_route",
      "category": "route",
      "severity": "info",
      "description": "Miniapp page route",
      "regex": "['\\\"]((?:pages|package|subpackages|subPackages|components|views)/[A-Za-z0-9_./-]+)['\\\"]"
    },
    {
      "id": "business_api_code",
      "category": "api",
      "severity": "info",
      "description": "Slash-style business API code such as UserCenter/User/index",
      "regex": "['\\\"]([A-Za-z][A-Za-z0-9_]*(?:/[A-Za-z0-9_.-]+){1,4})['\\\"]"
    },
    {
      "id": "client_app_code_param",
      "category": "api",
      "severity": "info",
      "description": "client/app code query or body value",
      "regex": "(?:client/app[^'\\\"`\\s]*[?&]code=|code=)([A-Za-z][A-Za-z0-9_]*(?:/[A-Za-z0-9_.-]+)+)"
    },
    {
      "id": "wx_storage_key",
      "category": "storage",
      "severity": "info",
      "description": "WeChat local storage key",
      "regex": "wx\\.(?:get|set|remove)Storage(?:Sync)?\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]"
    },
    {
      "id": "password_assignment",
      "category": "credential",
      "severity": "high",
      "description": "Password-like assignment",
      "regex": "(?i)(?:password|passwd|pwd)\\s*[:=]\\s*['\\\"]([^'\\\"]{3,128})['\\\"]"
    },
    {
      "id": "account_assignment",
      "category": "credential",
      "severity": "medium",
      "description": "Account/user assignment",
      "regex": "(?i)(?:account|username|user_name|loginName)\\s*[:=]\\s*['\\\"]([^'\\\"]{3,128})['\\\"]"
    },
    {
      "id": "token_assignment",
      "category": "token",
      "severity": "high",
      "description": "Token/session/cookie assignment",
      "regex": "(?i)(?:token|access_token|refresh_token|session|cookie|authorization|x-token)\\s*[:=]\\s*['\\\"]([^'\\\"]{8,512})['\\\"]"
    },
    {
      "id": "api_key_assignment",
      "category": "secret",
      "severity": "high",
      "description": "API key or secret assignment",
      "regex": "(?i)(?:api[_-]?key|app[_-]?key|secret|appsecret|client_secret)\\s*[:=]\\s*['\\\"]([^'\\\"]{8,512})['\\\"]"
    },
    {
      "id": "aliyun_ak",
      "category": "cloud",
      "severity": "critical",
      "description": "Alibaba Cloud AccessKey ID",
      "regex": "\\b((?:LTAI|STS)[A-Za-z0-9]{12,32})\\b"
    },
    {
      "id": "tencent_secret_id",
      "category": "cloud",
      "severity": "critical",
      "description": "Tencent Cloud SecretId",
      "regex": "\\b(AKID[A-Za-z0-9]{13,40})\\b"
    },
    {
      "id": "aws_access_key",
      "category": "cloud",
      "severity": "critical",
      "description": "AWS Access Key ID",
      "regex": "\\b((?:AKIA|ASIA)[A-Z0-9]{16})\\b"
    },
    {
      "id": "private_key_block",
      "category": "private_key",
      "severity": "critical",
      "description": "Private key block",
      "regex": "(-----BEGIN [A-Z ]*PRIVATE KEY-----)"
    },
    {
      "id": "china_mobile_phone",
      "category": "personal",
      "severity": "medium",
      "description": "Mainland China mobile phone number",
      "regex": "(?<!\\d)(1[3-9]\\d{9})(?!\\d)"
    },
    {
      "id": "china_id_card",
      "category": "personal",
      "severity": "high",
      "description": "Mainland China ID card number",
      "regex": "(?<!\\d)([1-9]\\d{5}(?:18|19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[0-9Xx])(?!\\d)"
    },
    {
      "id": "email_address",
      "category": "personal",
      "severity": "low",
      "description": "Email address",
      "regex": "\\b([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})\\b"
    },
    {
      "id": "jdbc_url",
      "category": "database",
      "severity": "critical",
      "description": "JDBC connection string",
      "regex": "(jdbc:[a-z0-9]+://[^\\s'\\\"`<>]+)"
    },
    {
      "id": "redis_url",
      "category": "database",
      "severity": "critical",
      "description": "Redis connection string",
      "regex": "(redis://[^\\s'\\\"`<>]+)"
    },
    {
      "id": "mongodb_url",
      "category": "database",
      "severity": "critical",
      "description": "MongoDB connection string",
      "regex": "(mongodb(?:\\+srv)?://[^\\s'\\\"`<>]+)"
    },
    {
      "id": "oss_bucket_url",
      "category": "cloud",
      "severity": "medium",
      "description": "Object storage bucket URL",
      "regex": "(https?://[^\\s'\\\"`<>]*(?:oss|cos|obs|s3)[^\\s'\\\"`<>]*)"
    },
    {
      "id": "payment_keyword",
      "category": "payment",
      "severity": "medium",
      "description": "Payment/order sensitive capability keyword",
      "regex": "\\b(requestPayment|refund|prepay_id|transaction_id|out_trade_no|coupon|point|integral|orderId|addressId)\\b"
    },
    {
      "id": "media_resource_ref",
      "category": "media",
      "severity": "info",
      "description": "Media/static resource reference",
      "regex": "['\\\"]([^'\\\"]+\\.(?:png|jpe?g|gif|webp|svg|mp3|wav|m4a|mp4|ttf|otf|woff2?)(?:\\?[^'\\\"]*)?)['\\\"]"
    }
  ]
}
