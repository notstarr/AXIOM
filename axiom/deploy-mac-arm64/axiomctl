#!/usr/bin/env bash
# AXIOM macOS 管理 CLI 工具
set -euo pipefail

ACTION="${1:-status}"
DOMAIN="gui/$(id -u)"
SERVER_LABEL="com.xrayai.axiom"
RUNNER_LABEL="com.xrayai.axiom.runner"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
HOST="${AXIOM_HOST:-127.0.0.1}"
PORT="${AXIOM_PORT:-8888}"

log() { printf '\033[1;32m[axiomctl]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[axiomctl] WARN:\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[axiomctl] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

is_service_running() {
  local label="$1"
  launchctl print "$DOMAIN/$label" >/dev/null 2>&1
}

wait_for_api() {
  printf "等待 AXIOM API 服务就绪 (http://%s:%s)" "$HOST" "$PORT"
  for _ in $(seq 1 30); do
    if curl -s --connect-timeout 1 "http://$HOST:$PORT/health" 2>/dev/null | grep -q '"api"'; then
      echo " ✓"
      return 0
    fi
    printf "."
    sleep 1
  done
  echo " 失败 ✗"
  return 1
}

start_service() {
  log "启动 AXIOM macOS 守护服务..."
  if [[ -f "$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist" ]]; then
    launchctl bootout "$DOMAIN" "$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist"
    launchctl kickstart -k "$DOMAIN/$SERVER_LABEL" 2>/dev/null || true
  fi

  wait_for_api || warn "API 服务启动较慢，请稍后检查状态"

  if [[ -f "$LAUNCH_AGENTS_DIR/$RUNNER_LABEL.plist" ]]; then
    launchctl bootout "$DOMAIN" "$LAUNCH_AGENTS_DIR/$RUNNER_LABEL.plist" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$LAUNCH_AGENTS_DIR/$RUNNER_LABEL.plist"
    launchctl kickstart -k "$DOMAIN/$RUNNER_LABEL" 2>/dev/null || true
  fi
  log "服务已启动完成！访问: http://$HOST:$PORT"
}

stop_service() {
  log "停止 AXIOM 服务..."
  if [[ -f "$LAUNCH_AGENTS_DIR/$RUNNER_LABEL.plist" ]]; then
    launchctl bootout "$DOMAIN" "$LAUNCH_AGENTS_DIR/$RUNNER_LABEL.plist" 2>/dev/null || true
  fi
  if [[ -f "$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist" ]]; then
    launchctl bootout "$DOMAIN" "$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist" 2>/dev/null || true
  fi
  log "服务已全部停止。"
}

restart_service() {
  log "重启 AXIOM 服务..."
  if is_service_running "$SERVER_LABEL"; then
    launchctl kickstart -k "$DOMAIN/$SERVER_LABEL"
    wait_for_api || true
  else
    start_service
    return
  fi
  if is_service_running "$RUNNER_LABEL"; then
    launchctl kickstart -k "$DOMAIN/$RUNNER_LABEL"
  fi
  log "重启完成！"
}

show_status() {
  echo "================================================="
  echo "📊 AXIOM macOS (Apple Silicon) 状态检查"
  echo "================================================="
  printf "• 平台架构: %s %s\n" "$(uname -s)" "$(uname -m)"
  printf "• 访问端点: http://%s:%s\n" "$HOST" "$PORT"
  
  echo "-------------------------------------------------"
  echo "[1] API 服务 (com.xrayai.axiom):"
  if is_service_running "$SERVER_LABEL"; then
    echo "  状态: 🟢 RUNNING (launchd)"
  else
    echo "  状态: 🔴 STOPPED"
  fi

  echo "[2] 调度引擎 (com.xrayai.axiom.runner):"
  if is_service_running "$RUNNER_LABEL"; then
    echo "  状态: 🟢 RUNNING (launchd)"
  else
    echo "  状态: 🔴 STOPPED"
  fi

  echo "[3] 健康检查 (HTTP /health):"
  local health
  health="$(curl -s --connect-timeout 2 "http://$HOST:$PORT/health" 2>/dev/null || true)"
  if [[ -n "$health" ]]; then
    echo "  响应: $health"
  else
    echo "  响应: 无法连接"
  fi
  echo "================================================="
}

show_logs() {
  local target="${2:-all}"
  local log_dir="$HOME/.local/share/axiom-v3/logs"
  case "$target" in
    server)
      tail -f "$log_dir/server.log"
      ;;
    dispatcher|runner)
      tail -f "$log_dir/dispatcher.log"
      ;;
    all|*)
      tail -f "$log_dir/server.log" "$log_dir/dispatcher.log"
      ;;
  esac
}

case "$ACTION" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    restart_service
    ;;
  status)
    show_status
    ;;
  logs)
    show_logs "${2:-all}"
    ;;
  *)
    echo "用法: axiomctl {start|stop|restart|status|logs [server|runner]}"
    exit 1
    ;;
esac
