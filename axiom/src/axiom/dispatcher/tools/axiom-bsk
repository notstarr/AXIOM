#!/usr/bin/env bash
# axiom-bsk — bsk 包装器：审计 + 透传
#
# 用法：axiom-bsk <bsk 子命令与参数>（与 bsk 完全同参）
# 环境依赖：AXIOM_RUN_DIR（审计落盘）
# Scope 在 Intent 派发时校验（声明即边界）；浏览器工具执行期不拦截。
set -u

# 锁死 bsk 版本：axiom 依赖 fork 的 `credentials` 子命令，上游 0.3.1 起已移除。
# bsk 默认自动升级（发现新版本会替换二进制并重启 daemon），必须关掉。
export BSK_AUTO_UPDATE=off

BSK_BIN="${BSK_BIN:-$HOME/.local/bin/bsk}"
RUN_DIR="${AXIOM_RUN_DIR:-}"
AUDIT_DIR="$RUN_DIR/evidence"
AUDIT_LOG="$AUDIT_DIR/bsk_audit.log"
mkdir -p "$AUDIT_DIR" 2>/dev/null

audit() {
  [ -n "$AUDIT_LOG" ] && echo "[$(date -u +%FT%TZ)] $*" >> "$AUDIT_LOG"
  return 0
}

cmd="${1:-}"
[ -z "$cmd" ] && exec "$BSK_BIN"
shift || true

audit "RUN $cmd $*"
exec "$BSK_BIN" "$cmd" "$@"
